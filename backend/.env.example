# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tradingbot?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# API Keys
# Get your FREE Twelve Data API key (800 calls/day)
# Sign up at: https://twelvedata.com/
# Use 'demo' for testing (limited pairs) or get your own key
TWELVE_DATA_API_KEY=demo

# Server Configuration
PORT=8000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001
